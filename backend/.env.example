# Copy this file to ".env" and fill in your real values.
# .env is never committed to git — it holds secrets.

PORT=5000

# PostgreSQL connection
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_db

# Used to sign/verify JWT tokens. Make this a long random string in production.
JWT_SECRET=super_secret_change_this_in_production
JWT_EXPIRES_IN=8h
