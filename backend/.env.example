# Copy to backend/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5001

# ---- PostgreSQL ----
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_db
DB_POOL_MAX=10
DB_SSL=false

# ---- Secrets ----
# Two DIFFERENT random strings. The server refuses to start in
# production if these are missing, short, or left as the examples.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
REFRESH_TOKEN_SECRET=replace_me_with_a_different_long_random_string

# Access tokens are short-lived on purpose: a stolen one expires
# quickly. The refresh token in the httpOnly cookie does the
# long-lived work and is rotated on every use.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# bcrypt work factor. Higher is slower to crack and slower to log
# in with; 12 is a reasonable 2024-era default. Raise it as
# hardware improves.
BCRYPT_ROUNDS=12

# Per-account lockout, on top of the per-IP rate limiter.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# How long a resolved permission set may be cached in memory.
# This is the worst case for how long a revoked permission keeps
# working, so keep it small.
PERMISSION_CACHE_SECONDS=15

# ---- CORS ----
# Comma-separated allow-list of the frontends permitted to call
# the API. Never use "*" here: the API sends credentials.
CORS_ORIGINS=http://localhost:5173

# ---- Rate limits ----
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MIN=1

# ---- First-run seed (optional) ----
# Leave SEED_ADMIN_PASSWORD unset and setup generates one and
# prints it once.
# SEED_ADMIN_EMAIL=admin@hospital.local
# SEED_ADMIN_PASSWORD=
